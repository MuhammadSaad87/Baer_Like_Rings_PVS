                                    (("" (INST -1 "one + inv(e)" "e")
                                      (("" (INST -8 "e" "one + inv(e)")
                                        (("" (CASE "idempotent?[T, *](R)(e)")
                                          (("1" (PROP) NIL NIL)
                                           ("2"
                                            (EXPAND
                                             "left_semicentral_idempotent?")
                                            (("2"
                                              (EXPAND
                                               "right_semicentral_idempotent?")
                                              (("2" (PROP) NIL NIL)) NIL))
                                            NIL))
                                          NIL))
                                        NIL))
                                      NIL))
                                    NIL))
                                  NIL))
                                NIL))
                              NIL))
                            NIL))
                          NIL))
                        NIL))
                      NIL))
                    NIL))
                  NIL))
                NIL))
              NIL))
            NIL))
          NIL))
        NIL))
      NIL))
    NIL)
   ((|semicentral_reduced?| CONST-DECL "bool" |special_rings_with_one| NIL)
    (|semicentral_idempotent?| CONST-DECL "bool" |special_rings_with_one| NIL)
    (|unital?| CONST-DECL "bool" |special_subrings| NIL)
    (|ring?| CONST-DECL "bool" |ring_def| |algebra|)
    (|inv_is_member_R| FORMULA-DECL NIL |ring_basic_properties| |algebra|)
    (|member| CONST-DECL "bool" |sets| NIL)
    (|cancel_right_minus| FORMULA-DECL NIL |ring| |algebra|)
    (|left_semicentral_alt| FORMULA-DECL NIL |special_rings_with_one| NIL)
    (|prime_ring_with_one?| CONST-DECL "bool" |special_rings_with_one| NIL)
    (|idempotent?| CONST-DECL "bool" |idempotent_def| NIL)
    (|star_closed?| CONST-DECL "bool" |groupoid_def| |algebra|)
    (|right_semicentral_idempotent?| CONST-DECL "bool" |special_rings_with_one|
     NIL)
    (|left_semicentral_idempotent?| CONST-DECL "bool" |special_rings_with_one|
     NIL)
    (|right_semicentral_alt| FORMULA-DECL NIL |special_rings_with_one| NIL)
    (|inv_right| FORMULA-DECL NIL |group| |algebra|)
    (|times_one| FORMULA-DECL NIL |ring_with_one| |algebra|)
    (|one_times| FORMULA-DECL NIL |ring_with_one| |algebra|)
    (|R_sum_star_closed| FORMULA-DECL NIL |ring_basic_properties| |algebra|)
    (AND CONST-DECL "[bool, bool -> bool]" |booleans| NIL)
    (= CONST-DECL "[T, T -> boolean]" |equalities| NIL)
    (|inv| CONST-DECL "{y | x * y = one AND y * x = one}" |group| |algebra|)
    (|one| FORMAL-CONST-DECL "T" |special_rings_with_one| NIL)
    (|zero| FORMAL-CONST-DECL "T" |special_rings_with_one| NIL)
    (* FORMAL-CONST-DECL "[T, T -> T]" |special_rings_with_one| NIL)
    (+ FORMAL-CONST-DECL "[T, T -> T]" |special_rings_with_one| NIL)
    (T FORMAL-NONEMPTY-TYPE-DECL NIL |special_rings_with_one| NIL)
    (|ring_with_one?| CONST-DECL "bool" |ring_with_one_def| |algebra|)
    (|set| TYPE-EQ-DECL NIL |sets| NIL)
    (|bool| NONEMPTY-TYPE-EQ-DECL NIL |booleans| NIL)
    (|boolean| NONEMPTY-TYPE-DECL NIL |booleans| NIL)
    (|one_unital| FORMULA-DECL NIL |nilpotent_def| NIL))
   SHOSTAK)))
