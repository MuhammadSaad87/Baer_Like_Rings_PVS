%% =============================================================================
%% ring_with_one_principal_ideal_def
%%   One-sided principal ideals aR, Ra and the two-sided principal ideal <a>,
%%   with the annihilator facts needed for Baer-like rings.
%% =============================================================================

ring_with_one_principal_ideal_def [T: TYPE+, +, *: [T, T -> T], zero: T]: THEORY
BEGIN

  ASSUMING
    IMPORTING algebra@ring_def[T, +, *, zero]
    fullset_is_ring: ASSUMPTION ring?(fullset[T])
  ENDASSUMING

  IMPORTING algebra@cosets_def[T, *],
            algebra@ring_principal_ideal[T, +, *, zero],
            special_subrings[T, +, *, zero]

  R:          VAR (ring?)
  a, e, u, x: VAR T

  right_principal_ideal_unity(R)(a): set[T] =
    {t: T | EXISTS (r: (R)): t = a * r}

  left_principal_ideal_unity(R)(a): set[T] =
    {t: T | EXISTS (r: (R)): t = r * a}

  principal_ideal_unity(R)(a: (R)): set[T] = principal_ideal(R)(a)

  %% Links to NASALib notation -------------------------------------------------

  right_principal_ideal_coset: LEMMA
    right_principal_ideal_unity(R)(a) = +[T, *](a, R)

  left_principal_ideal_coset: LEMMA
    left_principal_ideal_unity(R)(a) = +[T, *](R, a)

  %% Ideal properties -----------------------------------------------------------

  right_principal_ideal_is_ideal: LEMMA
    FORALL (a: (R)): right_ideal?(right_principal_ideal_unity(R)(a), R)

  left_principal_ideal_is_ideal: LEMMA
    FORALL (a: (R)): left_ideal?(left_principal_ideal_unity(R)(a), R)

  principal_ideal_unity_is_ideal: LEMMA
    FORALL (a: (R)): ideal?(principal_ideal_unity(R)(a), R)

  self_in_right_principal_ideal: LEMMA
    unital?(R)(u) AND R(a) IMPLIES right_principal_ideal_unity(R)(a)(a)

  self_in_left_principal_ideal: LEMMA
    unital?(R)(u) AND R(a) IMPLIES left_principal_ideal_unity(R)(a)(a)

  %% Principal one-sided ideals generated by an idempotent -----------------------

  right_principal_ideal_idempotent: LEMMA
    idempotent?[T, *](R)(e) IMPLIES
      (right_principal_ideal_unity(R)(e)(x) IFF (R(x) AND e * x = x))

  left_principal_ideal_idempotent: LEMMA
    idempotent?[T, *](R)(e) IMPLIES
      (left_principal_ideal_unity(R)(e)(x) IFF (R(x) AND x * e = x))

  % l(eR) = R(1-e) and r(Re) = (1-e)R.
  lann_right_principal_idempotent: LEMMA
    unital?(R)(u) AND idempotent?[T, *](R)(e) IMPLIES
      lann(R)(right_principal_ideal_unity(R)(e)) =
        left_principal_ideal_unity(R)(u + inv(e))

  rann_left_principal_idempotent: LEMMA
    unital?(R)(u) AND idempotent?[T, *](R)(e) IMPLIES
      rann(R)(left_principal_ideal_unity(R)(e)) =
        right_principal_ideal_unity(R)(u + inv(e))

  % If eR = Rf for idempotents e, f then e = f.
  idempotent_generators_equal: LEMMA
    idempotent?[T, *](R)(e) AND idempotent?[T, *](R)(x) AND
    right_principal_ideal_unity(R)(e) = left_principal_ideal_unity(R)(x)
      IMPLIES e = x

  %% Annihilator of a two-sided principal ideal (needs an identity) -------------

  % r(<a>) = r(aR) and l(<a>) = l(Ra) in a ring with identity.
  rann_principal_ideal_unity: LEMMA
    FORALL (a: (R)): unital?(R)(u) IMPLIES
      rann(R)(principal_ideal_unity(R)(a)) =
        rann(R)(right_principal_ideal_unity(R)(a))

  lann_principal_ideal_unity: LEMMA
    FORALL (a: (R)): unital?(R)(u) IMPLIES
      lann(R)(principal_ideal_unity(R)(a)) =
        lann(R)(left_principal_ideal_unity(R)(a))

END ring_with_one_principal_ideal_def
