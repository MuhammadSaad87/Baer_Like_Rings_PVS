%% =============================================================================
%% baer_ring_lemmas
%%   Relations between Baer-like rings; corners, center and prime rings.
%%
%% =============================================================================

baer_ring_lemmas [T: TYPE+, +, *: [T, T -> T], zero, one: T]: THEORY
BEGIN

  ASSUMING
    IMPORTING algebra@ring_with_one_def[T, +, *, zero, one]
    fullset_is_ring_with_one: ASSUMPTION ring_with_one?(fullset[T])
  ENDASSUMING

  IMPORTING algebra@ring_with_one[T, +, *, zero, one],
            idempotent_def[T, *],
            special_subrings[T, +, *, zero],
            ring_with_one_principal_ideal_def[T, +, *, zero],
            nilpotent_def[T, +, *, zero, one],
            special_rings_with_one[T, +, *, zero, one],
            baer_ring_def[T, +, *, zero, one]

  R: VAR (ring_with_one?)

  %% ---------------------------------------------------------------------------
  %% Abelian / reduced
  %% ---------------------------------------------------------------------------

  abelian_right_rickart_is_reduced: LEMMA
    abelian_ring?(R) AND right_rickart_ring?(R) IMPLIES reduced_ring?(R)

  abelian_left_rickart_is_reduced: LEMMA
    abelian_ring?(R) AND left_rickart_ring?(R) IMPLIES reduced_ring?(R)

  reduced_rann_principal: LEMMA
    reduced_ring?(R) IMPLIES
      FORALL (a: (R)):
        rann(R)(right_principal_ideal_unity(R)(a)) = rann(R)(singleton(a))

  reduced_lann_principal: LEMMA
    reduced_ring?(R) IMPLIES
      FORALL (a: (R)):
        lann(R)(left_principal_ideal_unity(R)(a)) = lann(R)(singleton(a))

  reduced_quasi_baer_is_baer: LEMMA
    reduced_ring?(R) AND quasi_baer_ring?(R) IMPLIES baer_ring?(R)

  baer_quasi_baer: THEOREM
    (abelian_ring?(R) AND baer_ring?(R)) IFF
    (reduced_ring?(R) AND quasi_baer_ring?(R))

  rickart_pq_baer_right: THEOREM
    (abelian_ring?(R) AND right_rickart_ring?(R)) IFF
    (reduced_ring?(R) AND right_pq_baer_ring?(R))

  rickart_pq_baer_left: THEOREM
    (abelian_ring?(R) AND left_rickart_ring?(R)) IFF
    (reduced_ring?(R) AND left_pq_baer_ring?(R))

  rickart_pq_baer: THEOREM
    (abelian_ring?(R) AND rickart_ring?(R)) IFF
    (reduced_ring?(R) AND pq_baer_ring?(R))

  %% ---------------------------------------------------------------------------
  %% Corners eRe
  %% ---------------------------------------------------------------------------

  Rg: VAR (ring?)

  % The conversion extend[T,(Rg),...] in singleton(a) is harmless.
  rann_singleton_ext: LEMMA
    FORALL (a: (Rg)): rann(Rg)(singleton(a)) = rann(Rg)(singleton[T](a))

  lann_singleton_ext: LEMMA
    FORALL (a: (Rg)): lann(Rg)(singleton(a)) = lann(Rg)(singleton[T](a))

  % Helpers for the corner theorems.
  corner_key_right: LEMMA
    FORALL (e, f: (idempotent?[T, *](R))):
      f * (one + inv(e)) = one + inv(e) IMPLIES e * f * e = e * f

  corner_key_left: LEMMA
    FORALL (e, f: (idempotent?[T, *](R))):
      (one + inv(e)) * f = one + inv(e) IMPLIES e * f * e = f * e

  corner_rann_idempotent: LEMMA
    FORALL (e, f: (idempotent?[T, *](R)), S: set[T]):
      subset?(S, corner(R)(e)) AND
      rann(R)(S) = right_principal_ideal_unity(R)(f) IMPLIES
        idempotent?[T, *](corner(R)(e))(e * f) AND
        rann(corner(R)(e))(S) =
          right_principal_ideal_unity(corner(R)(e))(e * f)

  corner_lann_idempotent: LEMMA
    FORALL (e, f: (idempotent?[T, *](R)), S: set[T]):
      subset?(S, corner(R)(e)) AND
      lann(R)(S) = left_principal_ideal_unity(R)(f) IMPLIES
        idempotent?[T, *](corner(R)(e))(f * e) AND
        lann(corner(R)(e))(S) =
          left_principal_ideal_unity(corner(R)(e))(f * e)

  baer_corners: THEOREM
    baer_ring?(R) IFF
      FORALL (e: (idempotent?[T, *](R))): baer_ring?(corner(R)(e))

  right_rickart_corners: LEMMA
    right_rickart_ring?(R) IFF
      FORALL (e: (idempotent?[T, *](R))): right_rickart_ring?(corner(R)(e))

  left_rickart_corners: LEMMA
    left_rickart_ring?(R) IFF
      FORALL (e: (idempotent?[T, *](R))): left_rickart_ring?(corner(R)(e))

  rickart_corners: THEOREM
    rickart_ring?(R) IFF
      FORALL (e: (idempotent?[T, *](R))): rickart_ring?(corner(R)(e))

  % Helpers for quasi_baer_corners and quasi_baer_center: in a quasi-Baer
  % ring the right (left) annihilator of a set closed under right (left)
  % multiplication by R is generated by a left (right) semicentral idempotent.
  qb_rann_swallow: LEMMA
    FORALL (S: set[T]):
      quasi_baer_ring?(R) AND subset?(S, R) AND
      (FORALL (s: (S), r: (R)): S(s * r)) IMPLIES
        EXISTS (f: (idempotent?[T, *](R))):
          left_semicentral_idempotent?(R)(f) AND
          rann(R)(S) = right_principal_ideal_unity(R)(f)

  qb_lann_swallow: LEMMA
    FORALL (S: set[T]):
      quasi_baer_ring?(R) AND subset?(S, R) AND
      (FORALL (s: (S), r: (R)): S(r * s)) IMPLIES
        EXISTS (f: (idempotent?[T, *](R))):
          right_semicentral_idempotent?(R)(f) AND
          lann(R)(S) = left_principal_ideal_unity(R)(f)

  corner_rann_semicentral: LEMMA
    FORALL (e, f: (idempotent?[T, *](R)), I: set[T]):
      subset?(I, corner(R)(e)) AND
      (FORALL (i: (I), t: (corner(R)(e))): I(i * t)) AND
      left_semicentral_idempotent?(R)(f) AND
      rann(R)({x: T | EXISTS (i: (I), r: (R)): x = i * r}) =
        right_principal_ideal_unity(R)(f) IMPLIES
        idempotent?[T, *](corner(R)(e))(e * f * e) AND
        rann(corner(R)(e))(I) =
          right_principal_ideal_unity(corner(R)(e))(e * f * e)

  quasi_baer_corners: THEOREM
    quasi_baer_ring?(R) IFF
      FORALL (e: (idempotent?[T, *](R))): quasi_baer_ring?(corner(R)(e))

  %% ---------------------------------------------------------------------------
  %% The center Z(R)
  %% ---------------------------------------------------------------------------

  % Helpers for quasi_baer_center: for a set S of central elements,
  % r(SR) = l(RS) = r(S).
  center_rann_right_mult: LEMMA
    FORALL (S: set[T]):
      subset?(S, ring_center(R)) IMPLIES
        rann(R)({x: T | EXISTS (s: (S), r: (R)): x = s * r}) = rann(R)(S)

  center_lann_left_mult: LEMMA
    FORALL (S: set[T]):
      subset?(S, ring_center(R)) IMPLIES
        lann(R)({x: T | EXISTS (s: (S), r: (R)): x = r * s}) = rann(R)(S)

  quasi_baer_center: THEOREM
    quasi_baer_ring?(R) IMPLIES baer_ring?(ring_center(R))

  % Stated in the literature; not proved in this development.
  rickart_center: CONJECTURE
    (left_rickart_ring?(R) OR right_rickart_ring?(R)) IMPLIES
      rickart_ring?(ring_center(R))

  % Stated in the literature; not proved in this development.
  pq_baer_center: CONJECTURE
    (left_pq_baer_ring?(R) OR right_pq_baer_ring?(R)) IMPLIES
      rickart_ring?(ring_center(R))

  %% ---------------------------------------------------------------------------
  %% Prime rings
  %% ---------------------------------------------------------------------------

  prime_is_quasi_baer: LEMMA
    prime_ring_with_one?(R) IMPLIES quasi_baer_ring?(R)

  % Helpers: one-sided p.q.-Baer + semicentral reduced implies prime.
  right_pq_baer_sr_is_prime: LEMMA
    right_pq_baer_ring?(R) AND semicentral_reduced?(R) IMPLIES
      prime_ring_with_one?(R)

  left_pq_baer_sr_is_prime: LEMMA
    left_pq_baer_ring?(R) AND semicentral_reduced?(R) IMPLIES
      prime_ring_with_one?(R)

  prime_iff_quasi_baer: THEOREM
    prime_ring_with_one?(R) IFF
      (quasi_baer_ring?(R) AND semicentral_reduced?(R))

  prime_iff_right_pq_baer: THEOREM
    prime_ring_with_one?(R) IFF
      (right_pq_baer_ring?(R) AND semicentral_reduced?(R))

  prime_iff_left_pq_baer: THEOREM
    prime_ring_with_one?(R) IFF
      (left_pq_baer_ring?(R) AND semicentral_reduced?(R))

  prime_iff_pq_baer: THEOREM
    prime_ring_with_one?(R) IFF
      (pq_baer_ring?(R) AND semicentral_reduced?(R))

  % The paper's combined statement, written as a conjunction of equivalences.
  prime_and_quasi_baer: THEOREM
    (prime_ring_with_one?(R) IFF
       (quasi_baer_ring?(R) AND semicentral_reduced?(R))) AND
    (prime_ring_with_one?(R) IFF
       (right_pq_baer_ring?(R) AND semicentral_reduced?(R))) AND
    (prime_ring_with_one?(R) IFF
       (left_pq_baer_ring?(R) AND semicentral_reduced?(R))) AND
    (prime_ring_with_one?(R) IFF
       (pq_baer_ring?(R) AND semicentral_reduced?(R)))

END baer_ring_lemmas
